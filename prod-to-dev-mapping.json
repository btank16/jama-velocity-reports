  "metadata": {
    "description": "Maps PROD Jama item types and fields to DEV equivalents. Used to convert PROD .vm report templates into DEV versions.",
    "created": "2026-03-04",
    "conventions": {
      "prod_only_fields": "Fields that exist in PROD but have no DEV equivalent — must be removed or conditionally skipped in DEV templates.",
      "dev_only_fields": "Fields that exist in DEV but not PROD — may need to be added to DEV templates.",
      "field_map keys": "Keyed by PROD unique_field_name. If the unique_field_name changes, dev.unique_field_name shows the new name."
    }
  },

